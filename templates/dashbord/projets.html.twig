{% extends 'dashbord/base.html.twig' %}

{% block title %}Gestion des Projets - ERP{% endblock %}
{% block page_title %}Gestion des Projets{% endblock %}
{% block icon %}kanban-fill{% endblock %}

{% block content %}
<div class="container-fluid">
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="stat-card">
                <div class="stat-icon" style="color: var(--primary);"><i class="bi bi-folder2-open"></i></div>
                <div class="stat-value">{{ totalProjets }}</div>
                <div class="stat-label">Total projets</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card">
                <div class="stat-icon" style="color: var(--success);"><i class="bi bi-check-circle"></i></div>
                <div class="stat-value">{{ totalActifs }}</div>
                <div class="stat-label">Projets actifs</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card">
                <div class="stat-icon" style="color: var(--danger);"><i class="bi bi-x-circle"></i></div>
                <div class="stat-value">{{ totalInactifs }}</div>
                <div class="stat-label">Projets inactifs</div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-12 d-flex justify-content-end">
            <a href="{{ path('dashbord_projet_new') }}" class="btn btn-primary">
                <i class="bi bi-plus-circle me-2"></i>Ajouter un projet
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-table me-2"></i>Liste des projets</h5>
                </div>
                <div class="card-body p-0">
                    {% if projets is not empty %}
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th>Nom</th>
                                        <th>Statut</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for projet in projets %}
                                        <tr>
                                            <td><strong>{{ projet.nom }}</strong></td>
                                            <td>
                                                {% if projet.isActive %}
                                                    <span class="badge badge-success">Actif</span>
                                                {% else %}
                                                    <span class="badge badge-danger">Inactif</span>
                                                {% endif %}
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% else %}
                        <div class="empty-state">
                            <i class="bi bi-inbox"></i>
                            <h5>Aucun projet trouvé</h5>
                            <p class="text-muted">Commencez par ajouter votre premier projet</p>
                            <a href="{{ path('dashbord_projet_new') }}" class="btn btn-primary mt-3">
                                <i class="bi bi-plus-circle me-2"></i>Ajouter un projet
                            </a>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}