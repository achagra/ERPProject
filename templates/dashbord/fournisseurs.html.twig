{% extends 'dashbord/base.html.twig' %}

{% block title %}Gestion des Fournisseurs - ERP{% endblock %}
{% block page_title %}Gestion des Fournisseurs{% endblock %}
{% block icon %}truck{% endblock %}

{% block content %}
<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-md-4 mb-3">
            <div class="stat-card">
                <div class="stat-icon" style="color: var(--primary);">
                    <i class="bi bi-truck"></i>
                </div>
                <div class="stat-value">{{ fournisseurs|length }}</div>
                <div class="stat-label">Total fournisseurs</div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="stat-card">
                <div class="stat-icon" style="color: var(--success);">
                    <i class="bi bi-person"></i>
                </div>
                <div class="stat-value">{{ totalParticuliers }}</div>
                <div class="stat-label">Fournisseurs particuliers</div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="stat-card">
                <div class="stat-icon" style="color: var(--info);">
                    <i class="bi bi-building"></i>
                </div>
                <div class="stat-value">{{ totalProfessionnels }}</div>
                <div class="stat-label">Fournisseurs professionnels</div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-12">
            <div style="display: flex; justify-content: flex-end; gap: 0.75rem;">
                <a href="{{ path('dashbord_fournisseur_new') }}" class="btn btn-primary">
                    <i class="bi bi-plus-circle me-2"></i>Ajouter un fournisseur
                </a>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-table me-2"></i>Liste des fournisseurs</h5>
                </div>
                <div class="card-body p-0">
                    {% if fournisseurs is not empty %}
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th>Nom complet</th>
                                        <th>Type</th>
                                        <th>Entreprise</th>
                                        <th>Email</th>
                                        <th>Téléphone</th>
                                        <th>Pays / Région</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for fournisseur in fournisseurs %}
                                    <tr>
                                        <td>{{ fournisseur.civilite }} {{ fournisseur.nomComplet }}</td>
                                        <td>
                                            <span class="badge" style="background: #dbeafe; color: #1e40af;">
                                                {{ fournisseur.type == 'particulier' ? 'Particulier' : 'Professionnel' }}
                                            </span>
                                        </td>
                                        <td>{{ fournisseur.nomEntreprise ?: '-' }}</td>
                                        <td>{{ fournisseur.email }}</td>
                                        <td>{{ fournisseur.telephone ?: '-' }}</td>
                                        <td>{{ fournisseur.pays }} / {{ fournisseur.region }}</td>
                                        <td>
                                            <div style="display: flex; gap: 0.5rem;">
                                                <a href="{{ path('dashbord_fournisseur_edit', {id: fournisseur.id}) }}" class="btn btn-sm" style="background: #fef3c7; color: #92400e; border: none; border-radius: 6px; padding: 0.4rem 0.8rem;" title="Modifier">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                                <button type="button" class="btn btn-sm" style="background: #fee2e2; color: #b91c1c; border: none; border-radius: 6px; padding: 0.4rem 0.8rem;" data-bs-toggle="modal" data-bs-target="#deleteFournisseurModal{{ fournisseur.id }}" title="Supprimer">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </div>

                                            <div class="modal fade" id="deleteFournisseurModal{{ fournisseur.id }}" tabindex="-1">
                                                <div class="modal-dialog">
                                                    <div class="modal-content">
                                                        <div class="modal-header">
                                                            <h5 class="modal-title"><i class="bi bi-exclamation-triangle me-2"></i>Confirmer la suppression</h5>
                                                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            <p>Supprimer le fournisseur <strong>{{ fournisseur.civilite }} {{ fournisseur.nomComplet }}</strong> ?</p>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                                                            <form method="POST" action="{{ path('dashbord_fournisseur_delete', {id: fournisseur.id}) }}" style="display: inline;">
                                                                <input type="hidden" name="_token" value="{{ csrf_token('delete_fournisseur' ~ fournisseur.id) }}">
                                                                <button type="submit" class="btn btn-danger">
                                                                    <i class="bi bi-trash me-2"></i>Supprimer
                                                                </button>
                                                            </form>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% else %}
                        <div class="empty-state">
                            <i class="bi bi-inbox"></i>
                            <h5>Aucun fournisseur trouvé</h5>
                            <p class="text-muted">Ajoutez votre premier fournisseur</p>
                            <a href="{{ path('dashbord_fournisseur_new') }}" class="btn btn-primary mt-3">
                                <i class="bi bi-plus-circle me-2"></i>Ajouter un fournisseur
                            </a>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
