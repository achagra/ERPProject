{% extends 'dashbord/base.html.twig' %}

{% block title %}Dashboard Entreprise - ERP{% endblock %}
{% block page_title %}Tableau de Bord Entreprise{% endblock %}
{% block icon %}building{% endblock %}

{% block content %}
<div class="container-fluid">
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>Bienvenue dans l'espace Entreprise
    </div>

    <div class="row mb-4">
        <div class="col-md-4 mb-3">
            <div class="stat-card">
                <div class="stat-icon" style="color: var(--primary);">
                    <i class="bi bi-person-badge"></i>
                </div>
                <div class="stat-value">{{ totalEmployes }}</div>
                <div class="stat-label">Employés</div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Profil de l'Entreprise</h5>
                </div>
                <div class="card-body">
                    <a href="#" class="btn btn-primary">Modifier le profil entreprise</a>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Actions Rapides</h5>
                </div>
                <div class="card-body">
                    <a href="{{ path('dashbord_employe_new') }}" class="btn btn-success w-100 mb-2">
                        <i class="bi bi-person-plus"></i> Ajouter un Employé
                    </a>
                    <a href="#" class="btn btn-info w-100">
                        <i class="bi bi-gear"></i> Autres paramètres
                    </a>
                </div>
            </div>
        </div>
    </div>

    {% if employes is not empty %}
    <div class="row mt-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="bi bi-person-badge me-2"></i>Derniers employés ajoutés</h5>
                    <a href="{{ path('dashbord_employes') }}" class="btn btn-light btn-sm">Voir tous</a>
                </div>
                <div class="card-body p-0">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Nom</th>
                                <th>Département</th>
                                <th>Téléphone</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for employe in employes %}
                            <tr>
                                <td><strong>{{ employe.nom }} {{ employe.prenom }}</strong></td>
                                <td>{{ employe.departement }}</td>
                                <td>{{ employe.telephone ?: '-' }}</td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    {% endif %}
</div>
{% endblock %}