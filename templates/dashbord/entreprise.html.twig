{% extends 'dashbord/base.html.twig' %}

{% block title %}Dashboard Entreprise - ERP{% endblock %}
{% block page_title %}Tableau de Bord Entreprise{% endblock %}
{% block icon %}building{% endblock %}

{% block content %}
<div class="container-fluid">
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>Bienvenue dans l'espace Entreprise
    </div>

    <div class="row mb-4">
        <div class="col-md-4 mb-3">
            <div class="stat-card">
                <div class="stat-icon" style="color: var(--primary);">
                    <i class="bi bi-person-badge"></i>
                </div>
                <div class="stat-value">{{ totalEmployes }}</div>
                <div class="stat-label">Employés</div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="stat-card">
                <div class="stat-icon" style="color: var(--success);">
                    <i class="bi bi-person"></i>
                </div>
                <div class="stat-value">{{ totalClientsParticuliers }}</div>
                <div class="stat-label">Clients particuliers</div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="stat-card">
                <div class="stat-icon" style="color: var(--info);">
                    <i class="bi bi-building"></i>
                </div>
                <div class="stat-value">{{ totalClientsProfessionnels }}</div>
                <div class="stat-label">Clients professionnels</div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="stat-card">
                <div class="stat-icon" style="color: var(--warning);">
                    <i class="bi bi-person"></i>
                </div>
                <div class="stat-value">{{ totalFournisseursParticuliers }}</div>
                <div class="stat-label">Fournisseurs particuliers</div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="stat-card">
                <div class="stat-icon" style="color: var(--secondary);">
                    <i class="bi bi-building"></i>
                </div>
                <div class="stat-value">{{ totalFournisseursProfessionnels }}</div>
                <div class="stat-label">Fournisseurs professionnels</div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-12 d-flex gap-2 flex-wrap">
            <a href="{{ path('dashbord_clients') }}" class="btn btn-primary">
                <i class="bi bi-person-lines-fill me-2"></i>Clients
            </a>
            <a href="{{ path('dashbord_fournisseurs') }}" class="btn btn-info">
                <i class="bi bi-truck me-2"></i>Fournisseurs
            </a>
        </div>
    </div>

</div>
{% endblock %}