{% extends 'dashbord/base.html.twig' %}

{% block title %}{{ 'nav.sales'|trans }} - ERP{% endblock %}
{% block page_title %}{{ 'nav.sales'|trans }}{% endblock %}
{% block icon %}cart-check{% endblock %}

{% block content %}
<div class="container-fluid">
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="stat-card">
                <div class="stat-icon" style="color: var(--primary);"><i class="bi bi-bag-check"></i></div>
                <div class="stat-value">{{ commandes|length }}</div>
                <div class="stat-label">Total commandes ventes</div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-12 d-flex justify-content-end">
            <a href="{{ path('dashbord_vente_new') }}" class="btn btn-primary">
                <i class="bi bi-plus-circle me-2"></i>Nouvelle commande client
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-table me-2"></i>Liste des commandes ventes</h5>
                </div>
                <div class="card-body p-0">
                    {% if commandes is not empty %}
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th>{{ 'common.client'|trans }}</th>
                                        <th>{{ 'common.date'|trans }}</th>
                                        <th>{{ 'common.warehouse'|trans }}</th>
                                        <th>{{ 'common.notes'|trans }}</th>
                                        <th class="text-end">{{ 'common.view'|trans }}</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for commande in commandes %}
                                        <tr>
                                            <td>{{ commande.client.nomComplet }}</td>
                                            <td>{{ commande.dateCommande ? commande.dateCommande|date('d/m/Y') : '-' }}</td>
                                            <td>{{ commande.entrepot.nom }}</td>
                                            <td>{{ commande.notes ?: '-' }}</td>
                                            <td class="text-end text-nowrap">
                                                <a href="{{ path('dashbord_vente_facture', {id: commande.id}) }}" class="btn btn-sm btn-outline-primary" title="Ouvrir la facture">
                                                    <i class="bi bi-receipt"></i>
                                                </a>
                                                <a href="{{ path('dashbord_vente_facture_pdf', {id: commande.id}) }}" class="btn btn-sm btn-outline-secondary" title="Télécharger le PDF">
                                                    <i class="bi bi-download"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% else %}
                        <div class="empty-state">
                            <i class="bi bi-inbox"></i>
                            <h5>Aucune commande vente trouvée</h5>
                            <p class="text-muted">Commencez par ajouter votre première commande client</p>
                            <a href="{{ path('dashbord_vente_new') }}" class="btn btn-primary mt-3">
                                <i class="bi bi-plus-circle me-2"></i>Nouvelle commande client
                            </a>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}