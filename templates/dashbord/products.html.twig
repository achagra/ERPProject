{% extends 'dashbord/base.html.twig' %}

{% block title %}Produits et services - ERP{% endblock %}
{% block page_title %}Produits et services{% endblock %}
{% block icon %}box-seam{% endblock %}

{% block content %}
<div class="container-fluid">
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-icon" style="color: var(--primary);">
                    <i class="bi bi-box-seam"></i>
                </div>
                <div class="stat-value">{{ totalProducts }}</div>
                <div class="stat-label">Produits et services</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-icon" style="color: var(--warning);">
                    <i class="bi bi-flower1"></i>
                </div>
                <div class="stat-value">{{ totalMatieresPremieres }}</div>
                <div class="stat-label">Matières premières</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-icon" style="color: var(--secondary);">
                    <i class="bi bi-puzzle"></i>
                </div>
                <div class="stat-value">{{ totalComposites }}</div>
                <div class="stat-label">Composites / assemblage</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stat-card">
                <div class="stat-icon" style="color: var(--success);">
                    <i class="bi bi-tools"></i>
                </div>
                <div class="stat-value">{{ totalServices }}</div>
                <div class="stat-label">Services</div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-12 d-flex justify-content-end">
            <a href="{{ path('dashbord_produit_new') }}" class="btn btn-primary">
                <i class="bi bi-plus-circle me-2"></i>Ajouter un produit ou service
            </a>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-lg-5">
            <div class="card h-100">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-tags me-2"></i>Catégories de produits</h5>
                </div>
                <div class="card-body">
                    {% if categories is not empty %}
                        <div class="d-flex flex-wrap gap-2">
                            {% for category in categories %}
                                <span class="badge bg-primary-subtle text-primary-emphasis border border-primary-subtle">{{ category.name }}</span>
                            {% endfor %}
                        </div>
                    {% else %}
                        <p class="text-muted mb-0">Aucune catégorie enregistrée pour l’instant.</p>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card h-100">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-plus-circle me-2"></i>Ajouter une catégorie</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-3">Créez une catégorie ici puis sélectionnez-la directement lors de l’ajout d’un produit ou service.</p>
                    {{ form_start(categoryForm) }}
                        <div class="row g-3 align-items-end">
                            <div class="col-md-8">
                                {{ form_row(categoryForm.name) }}
                            </div>
                            <div class="col-md-4">
                                <button type="submit" class="btn btn-outline-primary w-100">
                                    <i class="bi bi-save me-2"></i>Enregistrer
                                </button>
                            </div>
                        </div>
                    {{ form_end(categoryForm) }}
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <h5 class="mb-0"><i class="bi bi-table me-2"></i>Liste des produits et services</h5>
                        <small class="opacity-75">Organisation par type d’actif, catégorie et stock</small>
                    </div>
                </div>
                <div class="card-body p-0">
                    {% if products is not empty %}
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th>Nom</th>
                                        <th>Type d'actif</th>
                                        <th class="text-end">Prix de base</th>
                                        <th class="text-end">Quantité</th>
                                        <th>Catégorie</th>
                                        <th>Description</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for product in products %}
                                        {% set assetTypeLabel = {
                                            'matiere_premiere': 'Matière première',
                                            'composite_assemblage': 'Composite / assemblage',
                                            'service': 'Service'
                                        }[product.assetType] ?? '—' %}
                                        <tr>
                                            <td>
                                                <div class="fw-bold">{{ product.name }}</div>
                                            </td>
                                            <td><span class="badge bg-info text-dark">{{ assetTypeLabel }}</span></td>
                                            <td class="text-end">{{ product.price|number_format(0, ',', ' ') }}</td>
                                            <td class="text-end">{{ product.quantity }}</td>
                                            <td>{{ product.category ? product.category.name : '-' }}</td>
                                            <td>
                                                <div style="max-width: 420px; white-space: normal;">{{ product.description ?: '-' }}</div>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% else %}
                        <div class="empty-state">
                            <i class="bi bi-inbox"></i>
                            <h5>Aucun produit trouvé</h5>
                            <p class="text-muted">Ajoutez votre premier produit ou service.</p>
                            <a href="{{ path('dashbord_produit_new') }}" class="btn btn-primary mt-3">
                                <i class="bi bi-plus-circle me-2"></i>Ajouter un produit ou service
                            </a>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}