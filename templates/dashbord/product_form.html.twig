{% extends 'dashbord/base.html.twig' %}

{% block title %}{{ title }} - ERP{% endblock %}
{% block page_title %}{{ title }}{% endblock %}
{% block icon %}box-seam{% endblock %}

{% block content %}
<div class="container-fluid">
    <div class="row">
        <div class="col-xl-10 col-lg-11 mx-auto">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">{{ title }}</h5>
                </div>
                <div class="card-body">
                    <div class="alert alert-info mb-4">
                        <i class="bi bi-info-circle me-2"></i>
                        Renseignez d’abord l’identité du produit, puis son type d’actif, sa catégorie et sa description détaillée.
                    </div>
                    {{ form_start(form) }}
                        <div class="p-3 rounded-3 border bg-light mb-4">
                            <div class="d-flex align-items-center gap-2 mb-3">
                                <i class="bi bi-clipboard-data text-primary"></i>
                                <strong>Informations générales</strong>
                            </div>
                            <div class="row g-3">
                                <div class="col-lg-6">{{ form_row(form.name) }}</div>
                                <div class="col-lg-6">{{ form_row(form.category) }}</div>
                                <div class="col-lg-4">{{ form_row(form.assetType) }}</div>
                                <div class="col-lg-4">{{ form_row(form.price) }}</div>
                                <div class="col-lg-4">{{ form_row(form.quantity) }}</div>
                            </div>
                        </div>

                        <div class="p-3 rounded-3 border bg-light">
                            <div class="d-flex align-items-center gap-2 mb-3">
                                <i class="bi bi-file-text text-primary"></i>
                                <strong>Description détaillée</strong>
                            </div>
                            <div class="row">
                                <div class="col-12">
                                    {{ form_row(form.description) }}
                                </div>
                            </div>
                            <div class="small text-muted mt-2">
                                Utilisez cette zone pour préciser le contexte, les spécifications, les composants, les conditions d’utilisation ou les notes internes.
                            </div>
                        </div>

                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle me-2"></i>Enregistrer
                            </button>
                            <a href="{{ path('dashbord_produits') }}" class="btn btn-secondary">
                                <i class="bi bi-x-circle me-2"></i>Annuler
                            </a>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}