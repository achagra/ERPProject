{% extends 'dashbord/base.html.twig' %}

{% block title %}{{ title }} - ERP{% endblock %}
{% block page_title %}{{ title }}{% endblock %}
{% block icon %}truck{% endblock %}

{% block content %}
<div class="container-fluid">
    <div class="row">
        <div class="col-md-8 col-lg-7">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">{{ title }}</h5>
                </div>
                <div class="card-body">
                    {{ form_start(form) }}
                        <div class="row">
                            <div class="col-md-6">{{ form_row(form.type) }}</div>
                            <div class="col-md-6">{{ form_row(form.civilite) }}</div>
                        </div>
                        {{ form_row(form.nomComplet) }}
                        {{ form_row(form.nomEntreprise) }}
                        <div class="row">
                            <div class="col-md-6">{{ form_row(form.siteWeb) }}</div>
                            <div class="col-md-6">{{ form_row(form.numeroFiscale) }}</div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">{{ form_row(form.email) }}</div>
                            <div class="col-md-6">{{ form_row(form.telephone) }}</div>
                        </div>
                        <div class="row">
                            <div class="col-md-4">{{ form_row(form.pays) }}</div>
                            <div class="col-md-4">{{ form_row(form.region) }}</div>
                            <div class="col-md-4">{{ form_row(form.adresse) }}</div>
                        </div>

                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle me-2"></i>Enregistrer
                            </button>
                            <a href="{{ path('dashbord_fournisseurs') }}" class="btn btn-secondary">
                                <i class="bi bi-x-circle me-2"></i>Annuler
                            </a>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
