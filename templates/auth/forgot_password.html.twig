<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mot de passe oublié - ERP</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .card-container {
            background: white;
            border-radius: 16px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            width: 100%;
            max-width: 450px;
            overflow: hidden;
        }
        .card-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            padding: 2rem 1.5rem;
            text-align: center;
            color: white;
        }
        .card-header .logo { font-size: 3rem; margin-bottom: 0.5rem; }
        .card-header h1 { font-size: 1.5rem; font-weight: 700; margin-bottom: 0.5rem; }
        .card-header p { font-size: 0.9rem; opacity: 0.9; margin: 0; }
        .card-body { padding: 2rem; }
        .form-label { font-weight: 600; color: #1f2937; margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.5rem; }
        .form-control {
            border-radius: 10px;
            border: 1.5px solid #e5e7eb;
            padding: 0.75rem 1rem;
            font-size: 1rem;
            background: #f9fafb;
            transition: all 0.3s;
        }
        .form-control:focus {
            background: white;
            border-color: #667eea;
            box-shadow: 0 0 0 0.2rem rgba(102,126,234,0.25);
        }
        .btn-submit {
            width: 100%;
            padding: 0.875rem;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            border-radius: 10px;
            font-weight: 700;
            font-size: 1rem;
            cursor: pointer;
            transition: all 0.3s;
            margin-top: 1.5rem;
        }
        .btn-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(102,126,234,0.4);
        }
        .back-link {
            text-align: center;
            margin-top: 1.5rem;
            padding-top: 1.5rem;
            border-top: 1px solid #e5e7eb;
            font-size: 0.9rem;
            color: #6b7280;
        }
        .back-link a { color: #667eea; font-weight: 600; text-decoration: none; }
        /* POPUP */
        .modal-content { border-radius: 16px; border: none; }
        .modal-verify-icon { font-size: 4rem; color: #667eea; }
        .btn-verify {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            border-radius: 10px;
            padding: 0.75rem 2rem;
            font-weight: 700;
            transition: all 0.3s;
        }
        .btn-verify:hover { transform: translateY(-2px); color: white; box-shadow: 0 8px 20px rgba(102,126,234,0.4); }
    </style>
</head>
<body>
    <div class="card-container">
        <div class="card-header">
            <div class="logo"><i class="bi bi-speedometer2"></i></div>
            <h1>Mot de passe oublié</h1>
            <p>Entrez votre email pour recevoir un lien de réinitialisation</p>
        </div>
        <div class="card-body">
            <form method="post">
                <div class="mb-3">
                    <label class="form-label">
                        <i class="bi bi-envelope"></i> Adresse Email
                    </label>
                    <input
                        type="email"
                        name="email"
                        class="form-control"
                        placeholder="exemple@email.com"
                        required
                        autofocus
                    >
                </div>
                <button type="submit" class="btn-submit">
                    <i class="bi bi-send me-2"></i>Envoyer le lien
                </button>
            </form>

            <div class="back-link">
                <a href="{{ path('app_login') }}">
                    <i class="bi bi-arrow-left me-1"></i>Retour à la connexion
                </a>
            </div>
        </div>
    </div>

    {# POPUP après envoi #}
    {% if emailSent is defined and emailSent %}
    <div class="modal fade" id="sentModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-body text-center p-5">
                    <div class="modal-verify-icon mb-3">
                        <i class="bi bi-envelope-paper"></i>
                    </div>
                    <h4 style="font-weight:700; color:#1f2937;" class="mb-3">Email envoyé !</h4>
                    <p style="color:#6b7280; line-height:1.6;" class="mb-4">
                        Si un compte existe avec cette adresse, vous recevrez un email avec un lien pour réinitialiser votre mot de passe.
                        <br><br>
                        <i class="bi bi-clock me-1"></i> Le lien expire dans <strong>1 heure</strong>.
                    </p>
                    <a href="{{ path('app_login') }}" class="btn btn-verify">
                        <i class="bi bi-box-arrow-in-right me-2"></i>Retour à la connexion
                    </a>
                </div>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var modal = new bootstrap.Modal(document.getElementById('sentModal'), {
                backdrop: 'static',
                keyboard: false
            });
            modal.show();
        });
    </script>
    {% else %}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    {% endif %}
</body>
</html>